APP_ENV=local
CONTENT_ADAPTER=local
INQUIRY_ADAPTER=local
UPLOAD_ADAPTER=local
CALENDAR_ADAPTER=local
TELEMETRY_ADAPTER=local
PREVIEW_SECRET=replace-with-a-local-development-value

# ── SMTP / Email delivery ──────────────────────────────────
# For Gmail: use an App Password (not your account password).
# Generate one at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password-here

# Where incoming inquiries are delivered
CONTACT_TO=attackerv21@gmail.com

# The "From" address shown in the notification email
CONTACT_FROM=FINWEB SOLUTION <your-gmail@gmail.com>
